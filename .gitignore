# Terraform runtime
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log

# Local variable and backend files
*.tfvars
*.tfvars.json
*.backend.hcl
backend.hcl
!*.tfvars.example
!backend.hcl.example

# Targeted local state exports and recovery artifacts
state-export*.json
state-export*.txt
state-exports/
state-recovery/
recovery/*.json
recovery/*.tfstate*

# Credentials and secrets
.env
.env.*
.env-*
!.env.example
secrets/*
!secrets/README.md
*.p8
*.pem
*.key
*.pub
*.token

# Local scratch scripts that may contain credentials
lab00.ps1
lab*.local.ps1
lab*.local.sh

# Generated learner workspaces and reports
student-workspace/
student-track/_reports/
.student-workspace.json

# Lock file is committed in real projects; kept ignored here because the
# starter contains no .tf files yet.
.terraform.lock.hcl

# Python / dbt runtime
.venv/
venv/
__pycache__/
*.pyc
dbt_packages/
target/
logs/
profiles.yml
finops/target/
finops/logs/
finops/dbt_packages/
finops/profiles.yml

# IDE and operating system
.vscode/*.local.json
.idea/
.DS_Store
Thumbs.db

# Local reports generated by scripts
reports/
preflight*.md
preflight*.json
connectivity*.md
connectivity*.json
