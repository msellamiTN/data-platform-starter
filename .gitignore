# Terraform runtime
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log

# Local variable and backend files
*.tfvars
*.tfvars.json
*.backend.hcl
backend.hcl
!*.tfvars.example
!backend.hcl.example

# Targeted local state exports and recovery artifacts
state-export*.json
state-export*.txt
state-exports/
state-recovery/
recovery/*.json
recovery/*.tfstate*

# Credentials and secrets
.env
.env.*
.env-*
!.env.example
secrets/*
!secrets/README.md
*.p8
*.pem
*.key
*.pub
*.token

# Lock file is committed in real projects; kept ignored here because the
# starter contains no .tf files yet.
.terraform.lock.hcl

# Python / dbt runtime
.venv/
venv/
__pycache__/
*.pyc
dbt_packages/
target/
logs/
profiles.yml

# IDE and operating system
.vscode/*.local.json
.idea/
.DS_Store
Thumbs.db

# Local preflight reports generated by install-tools scripts
preflight.md
preflight.json
preflight-*.md
preflight-*.json

# Local connectivity reports generated by test-lab-connectivity scripts
reports/
connectivity.md
connectivity.json
connectivity-*.md
connectivity-*.json
