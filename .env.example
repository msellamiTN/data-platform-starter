# ============================================================
# Formation Terraform & Snowflake — .env.example
# ============================================================
# Instructor: fill in the real values below before distributing.
# Learner: copy this file to .env and update only your personal
#          values (LEARNER_PREFIX and SNOWFLAKE_PAT).
#
# .env is gitignored. Never commit it.
# Never put a PAT, password, client secret or private key in a
# committed file.
# ============================================================

# ============================================================
# Snowflake — account identifiers (provided by instructor)
# ============================================================

SNOWFLAKE_ORGANIZATION=ZVFXOZW
SNOWFLAKE_ACCOUNT=PM71247
SNOWFLAKE_HOST=ZVFXOZW-PM71247.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_LOCATOR=HQ33884
SNOWFLAKE_DATA_SHARING_IDENTIFIER=ZVFXOZW.PM71247
SNOWFLAKE_CLOUD_PLATFORM=AWS
SNOWFLAKE_EDITION=Enterprise

# ============================================================
# Snowflake — connection (provided by instructor)
# ============================================================

SNOWFLAKE_USER=DATA2AI
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_CONNECTION=training
SNOWFLAKE_AUTH_MODE=PAT

# ============================================================
# Learner personal values (update these)
# ============================================================

# Your unique prefix (3-5 uppercase letters, assigned by the instructor)
LEARNER_PREFIX=APP01

# Your Snowflake PAT (paste it here locally - this file is gitignored)
# Important: paste only the token characters, no extra spaces or quotes.
# If you leave this empty, the connection script will prompt you for it.
# Note: all learners share the same PAT (DATA2AI user). Isolation is via LEARNER_PREFIX.
SNOWFLAKE_PAT=

# ============================================================
# Azure backend (provided by instructor, used from Day 2)
# ============================================================

ARM_SUBSCRIPTION_ID=8c42d5b2-ab70-4051-ab0e-a96877557f6a
ARM_TENANT_ID=55fca982-2372-4352-8b7e-c28ac00ae8e3
ARM_RESOURCE_GROUP=rg-data2ai-tf-state
ARM_STORAGE_ACCOUNT=sadata2aitfstatemsn
ARM_CONTAINER=tfstate
ARM_LOCATION=northeurope

# [NOTE] ARM_LOCATION can be changed to any Azure region available for your subscription.
# Some regions (e.g. westeurope) may refuse new customers. Verify with:
#   az account list-locations -o table

# Azure service principal (shared by all learners - used by Terraform backend and provider)
# In KV-first mode, Learner-Login.ps1 fetches these from Key Vault automatically.
# In fallback mode, it reads from secrets/shared-sp.txt.
# You do NOT need to fill these in manually.
# WARNING: the secret is NOT stored here. Inject it via environment
# variable ARM_CLIENT_SECRET in your terminal session or CI pipeline.
ARM_CLIENT_ID=ab35eee0-5d09-4c4d-b41c-f536ce7dbdf0
# ARM_CLIENT_SECRET=<inject-at-runtime-never-commit>

# ============================================================
# Azure DevOps (provided by instructor, used from Day 5)
# ============================================================

ADO_ORGANIZATION=data2ai-tn
ADO_PROJECT=terraform-snowflake
ADO_SERVICE_CONNECTION=AzureKeyVault-Connection

# ============================================================
# Key Vault (provided by instructor, used from Day 4)
# ============================================================

KEY_VAULT_NAME=kvdata2aitfsecretsmsn
KEY_VAULT_RESOURCE_GROUP=rg-data2ai-tf-state

# ============================================================
# Deployment mode
# ============================================================
# training   = PAT authentication (Day 0 to Day 3)
# production = JWT key-pair authentication (Day 4+)
DEPLOYMENT_MODE=training

# ============================================================
# Paths (do not change unless you moved the project)
# ============================================================

SNOWFLAKE_PAT_FILE=secrets/snowflake_pat.txt
# [WARNING] SNOWFLAKE_PRIVATE_KEY_FILE is used only from Day 4+ (JWT key-pair auth).
# The Snowflake CLI reads SNOWFLAKE_* env vars as connection overrides.
# If this var is set in your session during PAT auth (Day 0-3), the CLI will
# force private-key auth and fail with:
#   "Private Key authentication requires authenticator set to SNOWFLAKE_JWT"
# The scripts New-SnowflakeConnection.ps1 and Test-LabConnectivity.ps1 automatically
# strip this var before invoking snow. Do NOT set it manually during PAT sessions.
# SNOWFLAKE_PRIVATE_KEY_FILE=secrets/snowflake_key.p8
ENVIRONMENT=DEV
TEAM=DATA_ENG
