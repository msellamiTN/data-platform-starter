# Instructor: fill in the real values below before distributing the template.
# Learner: copy this file to .env and update only your personal values
#           (LEARNER_PREFIX and SNOWFLAKE_PAT).
#
# .env is gitignored. Never commit it.
# Never put a PAT, password or private key in a committed file.

# ============================================================
# Snowflake access (provided by instructor)
# ============================================================

SNOWFLAKE_ORGANIZATION=ZVFXOZW
SNOWFLAKE_ACCOUNT=PM71247
SNOWFLAKE_HOST=ZVFXOZW-PM71247.snowflakecomputing.com
SNOWFLAKE_USER=DATA2AI
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_CONNECTION=training
SNOWFLAKE_AUTH_MODE=PAT

# ============================================================
# Learner personal values (update these)
# ============================================================

# Your unique prefix (3-5 uppercase letters, assigned by the instructor)
LEARNER_PREFIX=ABC

# Your Snowflake PAT (paste it here locally — this file is gitignored)
# Alternatively, the connection script will prompt you for it.
SNOWFLAKE_PAT=

# ============================================================
# Azure backend (provided by instructor, used from Day 2)
# ============================================================

ARM_SUBSCRIPTION_ID=<subscription-id>
ARM_TENANT_ID=<tenant-id>
ARM_RESOURCE_GROUP=rg-data-platform-tfstate
ARM_STORAGE_ACCOUNT=stdataplatformtfstate
ARM_CONTAINER=tfstate

# ============================================================
# Azure DevOps (provided by instructor, used from Day 5)
# ============================================================

ADO_ORGANIZATION=<ado-organization>
ADO_PROJECT=<ado-project>
ADO_SERVICE_CONNECTION=<service-connection-name>

# ============================================================
# Key Vault (provided by instructor, used from Day 4)
# ============================================================

KEY_VAULT_NAME=kv-data-platform
KEY_VAULT_RESOURCE_GROUP=rg-data-platform-kv

# ============================================================
# Paths (do not change unless you moved the project)
# ============================================================

SNOWFLAKE_PAT_FILE=secrets/snowflake_pat.txt
SNOWFLAKE_PRIVATE_KEY_FILE=secrets/snowflake_key.p8
ENVIRONMENT=DEV
