# ============================================================
# Formation Terraform & Snowflake — .env.example
# ============================================================
# Learner: copy this file to .env and update ONLY your personal values.
#
# .env is gitignored. Never commit it.
#
# Shared configuration (Snowflake account, Azure backend, Key Vault name)
# is in config/shared.env — that file is committed and loaded automatically
# by Learner-Login.ps1.
#
# Secrets (PAT, ARM_CLIENT_SECRET) are NOT stored here.
# The PAT is retrieved from Azure Key Vault at login time.
# The ARM_CLIENT_SECRET is in secrets/shared-sp.txt (distributed by instructor).
# ============================================================

# ============================================================
# Learner personal values (update these)
# ============================================================

# Your unique prefix (3-5 uppercase letters, assigned by the instructor)
LEARNER_PREFIX=APP01

# Deployment environment (DEV, UAT, or PROD)
ENVIRONMENT=DEV

# ============================================================
# Optional overrides (config/shared.env provides defaults)
# ============================================================
# Uncomment and set only if you need to override a shared value.

# SNOWFLAKE_USER=DATA2AI
# SNOWFLAKE_ROLE=SYSADMIN
# KEY_VAULT_NAME=kvdata2aitfsecrets
# ARM_RESOURCE_GROUP=rg-data2ai-tf-state
# ARM_STORAGE_ACCOUNT=sadata2aitfstatemsn
# ARM_CONTAINER=tfstate
# ARM_LOCATION=northeurope

# ============================================================
# Deployment mode
# ============================================================
# training   = PAT authentication (Day 0 to Day 3)
# production = JWT key-pair authentication (Day 4+)
DEPLOYMENT_MODE=training

# ============================================================
# Paths (do not change unless you moved the project)
# ============================================================

SNOWFLAKE_PAT_FILE=secrets/snowflake_pat.txt
SNOWFLAKE_PRIVATE_KEY_FILE=secrets/snowflake_key.p8
TEAM=DATA_ENG
