# Backend configuration template for DEV
#
# Copy this file to backend.hcl (gitignored) and fill in the values.
# backend.hcl is never committed to Git.
#
# Usage:
#   terraform init -backend-config=backend.hcl

resource_group_name  = "rg-data2ai-tf-state"
storage_account_name = "sadata2aitfstatemsn"
container_name       = "tfstate"
key                  = "training/APP01/dev/terraform.tfstate"
use_azuread_auth     = true

# Optional for workload identity federation (CI/CD):
# use_oidc             = true
# subscription_id      = "<your-subscription-id>"
# tenant_id            = "<your-tenant-id>"
