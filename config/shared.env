# ============================================================
# config/shared.env — Shared configuration (committed, no secrets)
# ============================================================
# This file is committed to Git and shared by all learners.
# It contains ONLY non-sensitive configuration values.
#
# Per-learner values (LEARNER_PREFIX, ENVIRONMENT) go in .env (gitignored).
# Secrets (PAT, ARM_CLIENT_SECRET, RSA keys) are retrieved from
# Azure Key Vault by Learner-Login.ps1 at runtime.
#
# Do NOT add secrets to this file.
# ============================================================

# ============================================================
# Snowflake — account identifiers (shared by all learners)
# ============================================================

SNOWFLAKE_ORGANIZATION=ZVFXOZW
SNOWFLAKE_ACCOUNT=PM71247
SNOWFLAKE_HOST=ZVFXOZW-PM71247.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_LOCATOR=HQ33884
SNOWFLAKE_DATA_SHARING_IDENTIFIER=ZVFXOZW.PM71247
SNOWFLAKE_CLOUD_PLATFORM=AWS
SNOWFLAKE_EDITION=Enterprise

# ============================================================
# Snowflake — connection (shared PAT, all learners use DATA2AI)
# ============================================================
# A single shared PAT is used by all learners for Snowflake CLI and Terraform.
# Resource isolation is achieved via LEARNER_PREFIX in resource names
# and separate Terraform state files per learner.
#
# The PAT is distributed by the instructor in secrets/snowflake_pat.txt (gitignored).
# No per-learner PAT generation is needed.

SNOWFLAKE_USER=DATA2AI
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_CONNECTION=training
SNOWFLAKE_AUTH_MODE=PAT

# ============================================================
# Azure Key Vault — secret store (shared by all learners)
# ============================================================
# Used from Day 4+ (security/auth lab) for learner-specific secrets.
# The shared PAT is NOT stored in Key Vault — it's in secrets/snowflake_pat.txt.

KEY_VAULT_NAME=kvdata2aitfsecretsmsn

# ============================================================
# Azure backend (shared by all learners, used from Day 2)
# ============================================================

ARM_SUBSCRIPTION_ID=8c42d5b2-ab70-4051-ab0e-a96877557f6a
ARM_TENANT_ID=55fca982-2372-4352-8b7e-c28ac00ae8e3
ARM_RESOURCE_GROUP=rg-data2ai-tf-state
ARM_STORAGE_ACCOUNT=sadata2aitfstatemsn
ARM_CONTAINER=tfstate
ARM_LOCATION=northeurope

# Azure service principal client ID (shared, non-sensitive).
# The secret (ARM_CLIENT_SECRET) is in secrets/shared-sp.txt (gitignored).
ARM_CLIENT_ID=ab35eee0-5d09-4c4d-b41c-f536ce7dbdf0

# ============================================================
# Azure DevOps (shared by all learners, used from Day 2)
# ============================================================

ADO_ORGANIZATION=data2ai-tn
ADO_PROJECT=terraform-snowflake
ADO_SERVICE_CONNECTION=<service-connection-name>

# ============================================================
# Key Vault for M10 (security/auth lab)
# ============================================================

KEY_VAULT_RESOURCE_GROUP=rg-data2ai-tf-state

# ============================================================
# Paths (do not change unless you moved the project)
# ============================================================

SNOWFLAKE_PAT_FILE=secrets/snowflake_pat.txt
SNOWFLAKE_PRIVATE_KEY_FILE=secrets/snowflake_key.p8
TEAM=DATA_ENG
